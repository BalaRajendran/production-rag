# ==============================================================================
# Production RAG Framework - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ==============================================================================
# Application Settings
# ==============================================================================
APP_APP_NAME=Production RAG Framework
APP_APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_API_HOST=0.0.0.0
APP_API_PORT=8000
APP_API_PREFIX=/api

# ==============================================================================
# LLM & Embedding Settings
# ==============================================================================
# OpenAI Configuration
LLM_OPENAI_API_KEY=your-openai-api-key-here
LLM_EMBEDDING_MODEL=text-embedding-3-large
LLM_EMBEDDING_DIMENSIONS=3072
LLM_LLM_MODEL=gpt-4-turbo-preview
LLM_LLM_TEMPERATURE=0.1
LLM_LLM_MAX_TOKENS=2000

# Cohere Configuration (for reranking)
LLM_COHERE_API_KEY=your-cohere-api-key-here
LLM_RERANKER_MODEL=rerank-english-v3.0

# ==============================================================================
# Vector Database Settings (Qdrant)
# ==============================================================================
VECTOR_QDRANT_HOST=localhost
VECTOR_QDRANT_PORT=6333
VECTOR_QDRANT_COLLECTION_NAME=rag_collection
VECTOR_QDRANT_TIMEOUT=30
VECTOR_VECTOR_DIMENSION=3072
VECTOR_DISTANCE_METRIC=cosine

# ==============================================================================
# RAG Pipeline Settings
# ==============================================================================
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_MIN_CHUNK_SIZE=100
RAG_TOP_K_RETRIEVAL=50
RAG_TOP_K_RERANK=15
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_QUERIES_GENERATED=5
RAG_ENABLE_QUERY_ROUTING=true
RAG_INCLUDE_SOURCES=true
RAG_MAX_CONTEXT_LENGTH=8000

# ==============================================================================
# Rate Limiting Settings
# ==============================================================================
RATE_LIMIT_RATE_LIMIT_ENABLED=true
RATE_LIMIT_RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_RATE_LIMIT_BURST=10

# Redis Configuration (for distributed rate limiting)
RATE_LIMIT_REDIS_ENABLED=true
RATE_LIMIT_REDIS_HOST=localhost
RATE_LIMIT_REDIS_PORT=6379
RATE_LIMIT_REDIS_DB=0
RATE_LIMIT_REDIS_PASSWORD=
RATE_LIMIT_REDIS_TIMEOUT=5

# ==============================================================================
# Observability Settings
# ==============================================================================
# Langfuse Configuration (optional - leave empty to disable)
OBS_LANGFUSE_ENABLED=false
OBS_LANGFUSE_PUBLIC_KEY=
OBS_LANGFUSE_SECRET_KEY=
OBS_LANGFUSE_HOST=https://cloud.langfuse.com
OBS_LANGFUSE_SAMPLE_RATE=1.0

# Logging Configuration
OBS_LOG_LEVEL=INFO
# Log format options: "json" (production) or "console"/"text" (development with colors)
OBS_LOG_FORMAT=console
OBS_LOG_FILE=
OBS_LOG_ROTATION=100 MB
OBS_LOG_RETENTION=30

# Metrics
OBS_ENABLE_METRICS=true
OBS_METRICS_PORT=9090
OBS_ENABLE_REQUEST_LOGGING=true
OBS_ENABLE_CORRELATION_ID=true
OBS_LOG_REQUEST_BODY=false
OBS_LOG_RESPONSE_BODY=false

# ==============================================================================
# Security Settings
# ==============================================================================
SECURITY_API_KEY_ENABLED=false
SECURITY_MAX_REQUEST_SIZE=10485760
SECURITY_REQUEST_TIMEOUT=300
SECURITY_ENABLE_SECURITY_HEADERS=true

# ==============================================================================
# Legacy Compatibility (for existing code)
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag_collection
EMBEDDING_MODEL=text-embedding-3-large
LLM_MODEL=gpt-4-turbo-preview
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=50
TOP_K_RERANK=15
MAX_QUERIES_GENERATED=5
API_HOST=0.0.0.0
API_PORT=8000

# ==============================================================================
# Production Recommendations
# ==============================================================================
# For production:
# 1. Set APP_ENVIRONMENT=production
# 2. Set APP_DEBUG=false
# 3. Enable Langfuse (OBS_LANGFUSE_ENABLED=true)
# 4. Set LOG_FORMAT=json
# 5. Set LOG_REQUEST_BODY=false and LOG_RESPONSE_BODY=false
# 6. Configure Redis password if using Redis Cloud
# 7. Monitor logs and metrics
